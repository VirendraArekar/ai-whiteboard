NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_whiteboard

JWT_ACCESS_SECRET=replace_with_secure_secret_key_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-whiteboard
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE=5242880

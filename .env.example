# Database (Standard PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_whiteboard
POSTGRES_PORT=5432

# MinIO (Local S3-compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKETS=ai-whiteboard:public

# Application URLs
PORT=3000
CLIENT_PORT=5173
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_whiteboard
